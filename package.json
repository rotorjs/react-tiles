{
  "name": "@rotorjs/react-tiles",
  "version": "0.0.0",
  "description": "Rotor",
  "author": {
    "name": "Aaron Burmeister"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotorjs/react-tiles.git"
  },
  "bugs": {
    "url": "https://github.com/rotorjs/react-tiles/issues"
  },
  "homepage": "https://github.com/rotorjs/",
  "type": "module",
  "keywords": [
    "state",
    "dashboards",
    "react"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/types/main.d.ts",
  "main": "./dist/esm/main.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/main.d.ts",
        "default": "./dist/esm/main.js"
      }
    },
    "./main": null,
    "./*": {
      "import": {
        "types": "./dist/types/*",
        "default": "./dist/esm/*"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b ./tsconfig-build.json && vite build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "prettify": "prettier . --write",
    "preview": "vite preview",
    "postversion": "git commit -am$npm_package_version",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/material-icons": "^5.2.7",
    "@fontsource/roboto": "^5.2.10",
    "@rotorjs/dashboard": "^0.7.2",
    "@rotorjs/react": "^0.14.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "prettier": "^3.9.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "unplugin-dts": "^1.0.3",
    "vite": "^8.1.0"
  },
  "peerDependencies": {
    "@rotorjs/dashboard": "^0.7.1",
    "@rotorjs/react": "^0.14.0",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.1.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "clsx": "^2.1.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  }
}
